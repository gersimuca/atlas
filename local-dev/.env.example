# Copy to .env if you want to override docker-compose defaults:
#   cp .env.example .env
#
# docker-compose.yml already sets sane defaults for everything below
# directly in its `environment:` blocks — this file exists mainly to
# document what's configurable, and as a place to put real Bedrock
# credentials if you want to flip USE_MOCK_LLM off locally.

# Set to false + provide real AWS credentials with Bedrock model access
# and a deployed Knowledge Base ID to talk to the real Claude model
# instead of the built-in mock.
USE_MOCK_LLM=true
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_KNOWLEDGE_BASE_ID=

# Only needed if USE_MOCK_LLM=false — real AWS credentials with Bedrock
# access (a personal IAM user/role, scoped down, never your root account).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=